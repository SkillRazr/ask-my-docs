OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
# Optional: a cheaper model for rewriting, reranking and judging
# OPENAI_SMALL_MODEL=gpt-4.1-nano
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
# Episode 4: the MCP server
# Over HTTP, each API key belongs to one tenant (key:tenant,key:tenant). With no keys,
# /mcp refuses every request. Make a key with: openssl rand -hex 32
# MCP_API_KEYS=paste-a-long-random-key:default
# MCP_CLIENT_KEY=paste-the-same-key        # what npm run mcp:client -- --http sends
# The tenant a local (stdio) MCP server reads
MCP_TENANT_ID=default
# Episode 5: who you are when you chat with the agent from the terminal
USER_KEY=me
# Episode 7: sign-in
# A long random secret that signs session tokens. Make one with: openssl rand -hex 32
AUTH_SECRET=paste-a-long-random-secret
APP_URL=http://localhost:3000
# From Google Cloud console > APIs & Services > Credentials > OAuth client ID (Web)
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=...
# Sign in by typing an invited email, with no Google setup. Laptop only, never in production.
AUTH_DEV_LOGIN=true
# Episode 8: the gateway
USER_REQUESTS_PER_MINUTE=20
USER_DAILY_BUDGET_USD=0.50
# Set to false to skip the model-based prompt injection check (the patterns still run)
GUARD_LLM_CHECK=true
# Episode 9: observability and evals
# Where traces go: console (print them), otlp (Jaeger or any OpenTelemetry collector),
# gcp (Cloud Trace) or none. Traces are on only for npm run dev.
TRACE_EXPORTER=none
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Your Google Cloud project, for Cloud Trace and for linking logs to traces
# GOOGLE_CLOUD_PROJECT=your-project-id
# Print one JSON log line per request, LLM call and agent run. On by default on Cloud Run.
# LOG_JSON=true
# The lowest score an eval may get before npm run eval or eval:agent fails
EVAL_MIN=0.8
# Episode 10: production
# Connections each instance keeps open to PostgreSQL. Times the number of instances,
# this must stay under the database's limit (25 on the smallest Cloud SQL instance).
DB_POOL_MAX=10
# On Google Cloud, connect to Cloud SQL with the connector instead of DATABASE_URL
# INSTANCE_CONNECTION_NAME=your-project:asia-south1:ask-my-docs-db
# DB_USER=app
# DB_PASSWORD=from Secret Manager, never in a file
# DB_NAME=askmydocs
# DB_IP_TYPE=PRIVATE   # episode 11
# A self-hosted model with an OpenAI-compatible API (optional)
# OPENAI_BASE_URL=https://your-model-server/v1
# Episode 11: a private worker service and Cloud Tasks (leave unset on your laptop)
# APP_MODE=worker                                   # on the worker service only
# TASKS_QUEUE=projects/your-project/locations/asia-south1/queues/ingestion
# WORKER_URL=https://ask-my-docs-worker-xxxx.a.run.app
# TASKS_INVOKER=ask-my-docs-tasks@your-project.iam.gserviceaccount.com
# PUBSUB_TOPIC=document-events
