{
  "name": "ask-my-docs",
  "version": "1.0.0",
  "private": true,
  "description": "The project you build in The AI-Ready Fresher, SkillRazr's free weekly AI engineering series",
  "type": "module",
  "scripts": {
    "db": "docker compose up -d",
    "migrate": "tsx src/db/migrate.ts",
    "ingest": "tsx src/ingest.ts",
    "ingest:db": "tsx src/ingest-db.ts",
    "worker": "tsx src/worker.ts",
    "search": "tsx src/search.ts",
    "ask": "tsx src/ask-docs.ts",
    "chat": "tsx src/chat.ts",
    "assistant": "tsx src/assistant.ts",
    "agent": "tsx src/agent-chat.ts",
    "describe": "tsx src/describe-image.ts",
    "users": "tsx src/users.ts",
    "guardrails": "tsx src/guardrails.ts",
    "mcp": "tsx src/mcp-stdio.ts",
    "mcp:client": "tsx src/mcp-client.ts",
    "mcp:inspect": "npx @modelcontextprotocol/inspector npx tsx src/mcp-stdio.ts",
    "eval": "tsx src/eval-rag.ts",
    "eval:agent": "tsx src/eval-agent.ts",
    "feedback": "tsx src/feedback-review.ts",
    "costs": "tsx src/costs.ts",
    "dev": "tsx --import ./src/telemetry.ts src/server.ts",
    "build": "node scripts/build.mjs",
    "start": "node --enable-source-maps --import ./dist/telemetry.mjs dist/server.mjs",
    "retention": "tsx src/retention.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc"
  },
  "license": "MIT",
  "dependencies": {
    "@google-cloud/cloud-sql-connector": "1.13.1",
    "@google-cloud/functions-framework": "5.0.5",
    "@google-cloud/opentelemetry-cloud-trace-exporter": "3.1.0",
    "@google-cloud/pubsub": "6.4.1",
    "@google-cloud/storage": "9.0.0",
    "@google-cloud/tasks": "7.3.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.81.2",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.2",
    "@opentelemetry/sdk-node": "0.223.2",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jose": "^6.2.18",
    "openai": "^7.57.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
